{
    "name": "dejwcake/advanced-logger",
    "description": "Advanced logger",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "logger",
        "request logger"
    ],
    "authors": [
        {
            "name": "David Běhal",
            "email": "david.behal@dejw.sk",
            "homepage": "https://www.dejw.sk",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/http": "^12.0",
        "illuminate/support": "^12.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.1",
        "laravel/framework": "^12.0",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Brackets\\AdvancedLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Brackets\\AdvancedLogger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev",
            "dev-v2-dev": "2.0-dev"
        },
        "laravel": {
            "providers": [
                "Brackets\\AdvancedLogger\\AdvancedLoggerServiceProvider"
            ]
        }
    }
}
