parameters:
	ignoreErrors:
		-
			message: '#^Access to an undefined property Illuminate\\Foundation\\Auth\\User\:\:\$email\.$#'
			identifier: property.notFound
			count: 1
			path: src/Interpolations/RequestInterpolation.php

		-
			message: '#^Call to function is_array\(\) with array\{\}\|list\{0\: non\-falsy\-string, 1\: non\-falsy\-string, 2\?\: non\-empty\-string, 3\?\: ''clf''\} will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Interpolations/RequestInterpolation.php

		-
			message: '#^Call to function method_exists\(\) with Illuminate\\Log\\Logger and ''getHandlers'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/LogCustomizers/HashLogCustomizer.php

		-
			message: '#^Call to an undefined method Psr\\Log\\LoggerInterface\:\:getLogger\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Loggers/RequestLogger.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertInstanceOf\(\) with ''Monolog\\\\Handler\\\\RotatingFileHandler'' and Brackets\\AdvancedLogger\\Handlers\\RequestLoggerHandler will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 1
			path: tests/Feature/Handlers/RequestLoggerHandlerTest.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertTrue\(\) with true will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 1
			path: tests/Unit/Listeners/RequestLoggerListenerHandler/ExcludedTest.php

		-
			message: '#^Parameter \#2 \$response of class Illuminate\\Foundation\\Http\\Events\\RequestHandled constructor expects Illuminate\\Http\\Response, Mockery\\MockInterface&Symfony\\Component\\HttpFoundation\\Response given\.$#'
			identifier: argument.type
			count: 3
			path: tests/Unit/Listeners/RequestLoggerListenerHandler/ExcludedTest.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertInstanceOf\(\) with ''Brackets\\\\AdvancedLogger\\\\Formatters\\\\LineWithHashFormatter'' and Brackets\\AdvancedLogger\\Formatters\\LineWithHashFormatter will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 1
			path: tests/Unit/LogCustomizers/HashLogCustomizerTest.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertInstanceOf\(\) with ''Monolog\\\\Handler\\\\HandlerInterface'' and Mockery\\MockInterface&Monolog\\Handler\\HandlerInterface will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 1
			path: tests/Unit/LogCustomizers/HashLogCustomizerTest.php
